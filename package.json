{
  "name": "poexd-extension",
  "version": "1.0.0",
  "private": true,
  "description": "Path of Exile 官方交易市集全方位輔助擴充套件，提供線上搜尋主控台、常用詞綴群組、階層書籤管理與 TFT 雙向互通。",
  "homepage": "https://github.com/yehshune/PoeXD-Extension#readme",
  "bugs": {
    "url": "https://github.com/yehshune/PoeXD-Extension/issues"
  },
  "license": "MIT",
  "author": "yehshune",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yehshune/PoeXD-Extension.git"
  },
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "filters:update": "node scripts/update-trade-filters.mjs",
    "data:sync": "node scripts/sync-game-data.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@lucide/vue": "^1.47.0",
    "@vueuse/core": "^15.0.0",
    "@webext-core/messaging": "^4.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.10.4",
    "sortablejs": "^1.15.7",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.29",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.1.43",
    "@types/node": "^26.6.1",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^4.1.9",
    "@wxt-dev/module-vue": "^1.0.3",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.68.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "vue-tsc": "^3.2.5",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.4"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@12.18.0"
}
